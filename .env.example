# Copy this file to .env and fill in values for your own setup.
# .env is gitignored — it's local to each machine this repo runs on.

# Root of BirdNET-Go's own data directory (contains birdnet.db, clips/, logs/).
# Default: ~/birdnet-go-app/data
#BIRDNETGO_DATA_DIR=/home/youruser/birdnet-go-app/data

# BirdNET-Go's web API, reachable from wherever this server runs.
# Default: http://localhost:8080
#BIRDNETGO_API_URL=http://localhost:8080

# BirdNET-Go's web UI as reachable from a browser on your LAN (phone,
# laptop). Only set this if it differs from BIRDNETGO_API_URL above —
# usually needed because "localhost" doesn't resolve from another device.
#BIRDNETGO_WEB_URL=http://192.168.1.50:8080

# birda (github.com/tphakala/birda) install location.
# Defaults: ~/.local/share/birda and ~/.local/bin/birda
#BIRDA_HOME=/home/youruser/.local/share/birda
#BIRDA_BIN=/home/youruser/.local/bin/birda
#BIRDA_ORT_DYLIB_PATH=/home/youruser/.local/share/birda/libonnxruntime.so

# Port the validator webapp listens on.
# Default: 8091
#WEBAPP_PORT=8091
